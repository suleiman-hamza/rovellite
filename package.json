{
  "name": "rovellite",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "node --require ./polyfill.cjs ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node --require ./polyfill.cjs ./node_modules/eslint/bin/eslint.js . --fix",
    "db:generate": "drizzle-kit generate --config ./server/database/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./server/database/drizzle.config.ts",
    "db:push": "drizzle-kit push --config ./server/database/drizzle.config",
    "typecheck": "nuxt typecheck",
    "db:types": "supabase gen types typescript --linked > types/supabase-schema.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.98",
    "@iconify-json/simple-icons": "^1.2.74",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.5.1",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@pinia/nuxt": "0.11.3",
    "@supabase/supabase-js": "^2.100.1",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.6.5",
    "@unovis/vue": "^1.6.5",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-vue": "^8.6.0",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "google-fonts": "^1.0.0",
    "jspdf": "^4.2.1",
    "lucide-vue-next": "^0.577.0",
    "maska": "^3.2.0",
    "nuxt": "^4.4.7",
    "postgres": "^3.4.8",
    "tailwindcss": "^4.2.1",
    "ws": "^8.20.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@nuxt/eslint": "^1.15.2",
    "@types/ws": "^8.18.1",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "^14.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.0.3",
    "nuxt-echarts": "^1.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.5"
  }
}
